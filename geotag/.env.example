# All of these are optional. On Vercel, set them under Project > Settings > Environment Variables.

# How this app identifies itself to OpenStreetMap Nominatim (asked for by their usage policy).
# Put your business name here.
NOMINATIM_USER_AGENT=GeotagPhotoGenerator/1.0 (your-business-name)
# Optional contact email sent to Nominatim with each fallback lookup.
NOMINATIM_EMAIL=

# Set to "off" to never look places up online (bundled Gujarat list only).
FALLBACK_GEOCODER=

# Only needed if the page is hosted at a different address than the API.
CORS_ORIGIN=

# Local development only: port of the API server (the page's dev server forwards /api to 4000).
PORT=4000
