{
  "name": "geotag-photo-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Adds a location strip under a photo. Places are looked up in a bundled Gujarat database.",
  "scripts": {
    "dev": "tsx watch server/src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:data": "tsx server/scripts/build-locations.ts",
    "test": "tsx server/scripts/smoke-test.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "open-location-code": "^1.0.3",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
